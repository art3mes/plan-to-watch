VITE_TEXTURES_BASE_URL=/media
VITE_FILM_INFO_BASE_URL=/json

# Layer counts. These match the sample committed to the repo (the 216 most
# popular titles, repeated across the wall). After a full `pnpm anime:atlases`
# use the counts it prints instead - currently 1, 4, 100 and 398.
VITE_MEDIA_VERSION_0_LAYERS=1
VITE_MEDIA_VERSION_1_LAYERS=1
VITE_MEDIA_VERSION_2_LAYERS=1
VITE_MEDIA_VERSION_3_LAYERS=4
VITE_EXPERIMENTAL_MEDIA_VERSION_3_ENABLED=1

# Shaders are always minified by `pnpm build`; set to 1 to minify in dev too
VITE_COMPRESS_GLSL=
VITE_ANALYZE_BUNDLE=

# Only the data scripts use this, never the website - from myanimelist.net/apiconfig
MAL_CLIENT_ID=
