# Production build settings. Copy to .env.production before `pnpm build`.
#
# Everything ships with the site: posters are packed into 9x6 sheets, so the
# deployment is a few hundred files rather than the 21,472 that individual
# posters would need. No object storage or CDN account is involved.
VITE_TEXTURES_BASE_URL=/media
VITE_FILM_INFO_BASE_URL=/json

# Layer counts printed by `pnpm anime:atlases` - keep in step with the data.
VITE_MEDIA_VERSION_0_LAYERS=1
VITE_MEDIA_VERSION_1_LAYERS=4
VITE_MEDIA_VERSION_2_LAYERS=100

# The experimental full-resolution texture layer wants one image per title,
# which is what the sheets replaced. Leave it off.
VITE_EXPERIMENTAL_MEDIA_VERSION_3_ENABLED=

VITE_COMPRESS_GLSL=1
VITE_ANALYZE_BUNDLE=
