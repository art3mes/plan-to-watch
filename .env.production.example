# Production build settings. Copy to .env.production before `pnpm build`.
#
# Both paths stay relative: the Pages Function in functions/media/ serves the
# R2 bucket under /media/*, so the browser sees same-origin URLs and the build
# needs no bucket hostname. Film data lives in the bucket under json/.
VITE_TEXTURES_BASE_URL=/media
VITE_FILM_INFO_BASE_URL=/media/json

# Layer counts printed by `pnpm anime:atlases` - keep in step with the data.
VITE_MEDIA_VERSION_0_LAYERS=1
VITE_MEDIA_VERSION_1_LAYERS=4
VITE_MEDIA_VERSION_2_LAYERS=100
VITE_EXPERIMENTAL_MEDIA_VERSION_3_ENABLED=1

VITE_COMPRESS_GLSL=1
VITE_ANALYZE_BUNDLE=
